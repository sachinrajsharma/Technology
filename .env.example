# Other Yugty sites, shown in the footer and menus. Defaults are the live domains; set one only to override it.
NEXT_PUBLIC_APP_URL_HOME=
NEXT_PUBLIC_APP_URL_STUDIO=
NEXT_PUBLIC_APP_URL_COLLEGES=
NEXT_PUBLIC_APP_URL_LEARNING=
NEXT_PUBLIC_APP_URL_AI=
NEXT_PUBLIC_APP_URL_TECH=
NEXT_PUBLIC_APP_URL_JOBS=
NEXT_PUBLIC_APP_URL_PR=
NEXT_PUBLIC_APP_URL_MATHSTUDY=

# Public origin of this site (used for metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Project briefs from /contact are emailed with Resend. Without these a dev server logs the brief; production refuses (503).
RESEND_API_KEY=
INQUIRY_TO=hello@example.com
INQUIRY_FROM=Yugty Tech <onboarding@resend.dev>

# Optional links to the other Yugty portals. A link shows only when its URL is set.
# Origin that serves the AI tools (/ai-resume-expert and so on). Empty shows them as plain cards.
NEXT_PUBLIC_AI_TOOLS_URL=
